[Unit]
Description=NanoClaw Personal Assistant
After=network.target

[Service]
Type=simple
ExecStart=/home/daniel/.nvm/versions/node/v24.13.1/bin/node /home/daniel/nanoclaw/dist/index.js
WorkingDirectory=/home/daniel/nanoclaw
Restart=always
RestartSec=5
Environment=HOME=/home/daniel
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/daniel/.local/bin
StandardOutput=append:/home/daniel/nanoclaw/logs/nanoclaw.log
StandardError=append:/home/daniel/nanoclaw/logs/nanoclaw.error.log

[Install]
WantedBy=default.target